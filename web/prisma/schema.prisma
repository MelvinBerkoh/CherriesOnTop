generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuoteRequestStatus {
  NEW
  CONTACTED
  QUOTED
  BOOKED
  CLOSED
}

model QuoteRequest {
  id                  String             @id @default(cuid())
  status              QuoteRequestStatus @default(NEW)
  name                String
  email               String
  phone               String?
  eventType           String
  eventDate           DateTime           @db.Date
  preferredTime       String?
  location            String
  guestCount          Int
  packageId           String?
  packageName         String?
  estimatedTotalCents Int?
  message             String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  booking             Booking?

  @@index([status, createdAt])
  @@index([eventDate])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum PublicEventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model PublicEvent {
  id           String            @id @default(cuid())
  status       PublicEventStatus @default(DRAFT)
  title        String
  description  String
  location     String
  address      String
  startsAt     DateTime          @db.Timestamptz(3)
  endsAt       DateTime          @db.Timestamptz(3)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  reservations DayReservation[]

  @@index([status, startsAt])
  @@index([status, endsAt])
}

enum BookingStatus {
  HOLD
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum ReservationKind {
  HOLD
  PRIVATE_EVENT
  PUBLIC_EVENT
  BLOCKED
}

model Booking {
  id                    String           @id @default(cuid())
  status                BookingStatus    @default(HOLD)
  eventDate             DateTime         @db.Date
  startsAt              DateTime         @db.Timestamptz(3)
  endsAt                DateTime         @db.Timestamptz(3)
  title                 String
  customerName          String
  customerEmail         String?
  customerPhone         String?
  location              String
  guestCount            Int?
  quotedTotalCents      Int?
  internalNotes         String?
  holdExpiresAt         DateTime?        @db.Timestamptz(3)
  confirmationTokenHash String?          @unique
  quoteRequestId        String?          @unique
  quoteRequest          QuoteRequest?    @relation(fields: [quoteRequestId], references: [id], onDelete: Restrict)
  reservations          DayReservation[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([status, eventDate])
  @@index([status, holdExpiresAt])
}

model DayReservation {
  id            String          @id @default(cuid())
  date          DateTime        @unique @db.Date
  kind          ReservationKind
  bookingId     String?
  booking       Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  publicEventId String?
  publicEvent   PublicEvent?    @relation(fields: [publicEventId], references: [id], onDelete: Restrict)
  internalNotes String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([bookingId])
  @@index([publicEventId])
}
